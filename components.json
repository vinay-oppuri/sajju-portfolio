{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "registryUrl": "https://raw.githubusercontent.com/palakonweb/Rewamp-UI/main/registry",
  "repoRawUrl": "https://raw.githubusercontent.com/palakonweb/Rewamp-UI/main",
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "components/ui",
